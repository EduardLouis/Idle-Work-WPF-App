<!-- [v0.1: MainWindow] Main application shell with Fluent navigation sidebar and view templates -->
<Window x:Class="IdleWork.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:IdleWork.App.ViewModels"
        xmlns:views="clr-namespace:IdleWork.App.Views"
        mc:Ignorable="d"
        Title="{Binding AppTitle}" 
        Height="820" Width="1240"
        MinHeight="650" MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgDarkBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ViewModel to View Mappings -->
            <DataTemplate DataType="{x:Type vm:LiveTrackerViewModel}">
                <views:LiveTrackerView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:TimelineViewModel}">
                <views:TimelineView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:WeeklyTimesheetViewModel}">
                <views:WeeklyTimesheetView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:RulesManagerViewModel}">
                <views:RulesManagerView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ProjectsViewModel}">
                <views:ProjectsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar Navigation -->
        <Border Grid.Column="0" Background="#0C1322" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="16,20,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- App Branding -->
                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="12" Height="12" CornerRadius="6" Background="{StaticResource ActiveBrush}" Margin="0,0,8,0" />
                        <TextBlock Text="Idle-Work" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>
                    <TextBlock Text="Activity &amp; Timesheets" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="20,2,0,0" />
                </StackPanel>

                <!-- Version Badge Button -->
                <Border Grid.Row="1" Background="#162032" CornerRadius="6" Padding="10,6" Margin="0,0,0,24" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding VersionTag}" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" FontSize="12" />
                            <TextBlock Text="{Binding BuildStamp, StringFormat='Build {0}'}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Command="{Binding ShowMilestonesCommand}" Content="History" FontSize="10" Padding="6,2" />
                    </Grid>
                </Border>

                <!-- Navigation Links -->
                <StackPanel Grid.Row="2">
                    <Button Style="{StaticResource NavButton}" Command="{Binding NavigateLiveTrackerCommand}" Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚡" Margin="0,0,12,0" FontSize="14" />
                            <TextBlock Text="Live Tracker" FontSize="13" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NavButton}" Command="{Binding NavigateTimelineCommand}" Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📅" Margin="0,0,12,0" FontSize="14" />
                            <TextBlock Text="Daily Timeline" FontSize="13" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NavButton}" Command="{Binding NavigateWeeklyTimesheetCommand}" Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊" Margin="0,0,12,0" FontSize="14" />
                            <TextBlock Text="Weekly Timesheet" FontSize="13" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NavButton}" Command="{Binding NavigateRulesCommand}" Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🏷️" Margin="0,0,12,0" FontSize="14" />
                            <TextBlock Text="Smart Rules" FontSize="13" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NavButton}" Command="{Binding NavigateProjectsCommand}" Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📁" Margin="0,0,12,0" FontSize="14" />
                            <TextBlock Text="Projects" FontSize="13" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NavButton}" Command="{Binding NavigateSettingsCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙️" Margin="0,0,12,0" FontSize="14" />
                            <TextBlock Text="Preferences" FontSize="13" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Footer Status -->
                <Border Grid.Row="3" Background="#162032" CornerRadius="6" Padding="10,8" BorderBrush="#253347" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource ActiveBrush}" Margin="0,0,8,0" />
                        <TextBlock Text="Tracking Active" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Main Body Area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Header Bar -->
            <Border Grid.Row="0" Background="#0F172A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding CurrentPageTitle}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" />

                    <!-- Header Status Pill -->
                    <Border Grid.Column="1" Background="#1E293B" CornerRadius="12" Padding="12,4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Multi-Monitor &amp; CoreAudio:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,6,0" />
                            <TextBlock Text="Online" FontSize="11" FontWeight="Bold" Foreground="{StaticResource ActiveBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Dynamic View Host -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentView}" />
        </Grid>
    </Grid>
</Window>
