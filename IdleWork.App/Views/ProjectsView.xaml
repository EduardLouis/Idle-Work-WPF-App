<!-- [v0.2: ProjectsView] User-defined projects and client codes management UI -->
<UserControl x:Class="IdleWork.App.Views.ProjectsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:helpers="clr-namespace:IdleWork.App.Core.Helpers"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1000">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Project Management" FontSize="20" FontWeight="Bold" />
                <TextBlock Text="Define your project accounts, codes, and color palettes to assign activities and track timesheets." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" Content="🔄 Refresh Projects" />
        </Grid>

        <!-- Main Content Area: Left = Project List, Right = Edit Form -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- Projects List Card -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Active Projects &amp; Accounts" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8" />

                    <!-- Toolbar -->
                    <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Style="{StaticResource SecondaryButton}" Command="{Binding ClearFormCommand}" Content="➕ New Project" Padding="8,4" FontSize="11" Margin="0,0,6,0" />
                        <Button Style="{StaticResource SecondaryButton}" Command="{Binding DeleteProjectCommand}" Content="🗑 Delete Selected" Padding="8,4" FontSize="11" Foreground="#EF4444" />
                    </WrapPanel>

                    <!-- Projects ListView -->
                    <ListView Grid.Row="2" ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}"
                              Background="Transparent" BorderThickness="0"
                              helpers:ScrollHelper.BubbleMouseWheel="True">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#162032" CornerRadius="6" Padding="12,10" Margin="0,0,0,6" BorderBrush="#253347" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Project Color Bar -->
                                        <Border Grid.Column="0" Width="4" CornerRadius="2" Background="{Binding ColorHex}" HorizontalAlignment="Left" />

                                        <!-- Project Code Badge -->
                                        <Border Grid.Column="1" Background="#0F172A" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Code}" FontWeight="Bold" Foreground="{Binding ColorHex}" FontSize="11" />
                                        </Border>

                                        <!-- Project Name & Description -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" />
                                            <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <!-- Active Indicator -->
                                        <Border Grid.Column="3" Background="#1E293B" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                            <TextBlock Text="Active" Foreground="{StaticResource ActiveBrush}" FontSize="10" FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- Project Form Card -->
            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Project Details" FontSize="16" FontWeight="SemiBold" />
                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Command="{Binding ClearFormCommand}" Content="Clear / New" FontSize="10" Padding="6,2" />
                        </Grid>

                        <TextBlock Text="Project Name (e.g. City Center Hospital)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                        <TextBlock Text="Project Code (e.g. CCH-2026, BIM)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding ProjectCode, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                        <!-- Color Preset Picker -->
                        <TextBlock Text="Color Tag" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ItemsControl ItemsSource="{Binding ColorPresets}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Background="{Binding}" Width="24" Height="24" Margin="0,0,6,0" BorderThickness="0" Cursor="Hand"
                                                Command="{Binding DataContext.SelectColorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="12" BorderBrush="#FFF" BorderThickness="1" />
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </WrapPanel>
                        <TextBox Text="{Binding ProjectColorHex, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                        <TextBlock Text="Description (Optional)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding ProjectDescription, UpdateSourceTrigger=PropertyChanged}" Height="50" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,16" />

                        <!-- Correlated Classification Rules -->
                        <TextBlock Text="Associated Classification Rules" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock Text="Select rules to link with this project, or define a new rule below:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,8" />

                        <!-- Rules Checklist -->
                        <Border Background="#0F172A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" MaxHeight="130" Margin="0,0,0,10" Padding="6">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding AvailableRules}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="4,3" Cursor="Hand">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding RuleName}" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,8,0" />
                                                    <TextBlock Text="{Binding SummaryText, StringFormat='({0})'}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                                </StackPanel>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <!-- Quick Add Rule -->
                        <TextBlock Text="Create &amp; Link New Rule" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2" />
                        <TextBlock Text="Matches window title substring (e.g. 'Hospital'). Blank matches all windows." FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding NewRuleProcessFilter, UpdateSourceTrigger=PropertyChanged}" ToolTip="Process name (e.g. Revit, acad)" FontSize="11" />
                            <TextBox Grid.Column="2" Text="{Binding NewRuleTitlePattern, UpdateSourceTrigger=PropertyChanged}" ToolTip="Title keyword or substring (e.g. Hospital). Matches text inside active window titles. Blank matches any window." FontSize="11" />
                            <Button Grid.Column="4" Style="{StaticResource SecondaryButton}" Command="{Binding AddQuickRuleCommand}" Content="➕ Add" Padding="8,4" FontSize="11" />
                        </Grid>

                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding SaveProjectCommand}" Content="{Binding SaveButtonText}" HorizontalAlignment="Stretch" Padding="14,10" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Status Message -->
        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Foreground="{StaticResource ActiveBrush}" Margin="0,8,0,0" FontSize="12" FontWeight="Medium" />
    </Grid>
</UserControl>
