<!-- [v0.2: ProjectsView] User-defined projects, categories, and tags management UI -->
<UserControl x:Class="IdleWork.App.Views.ProjectsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:helpers="clr-namespace:IdleWork.App.Core.Helpers"
             mc:Ignorable="d" 
             d:DesignHeight="780" d:DesignWidth="1050">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Project &amp; Classification Management" FontSize="20" FontWeight="Bold" />
                <TextBlock Text="Configure projects, categories, and tags to classify your activities and track timesheets accurately." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" Content="🔄 Refresh All" />
        </Grid>

        <!-- Main Tab Control -->
        <TabControl Grid.Row="1">
            <!-- TAB 1: Projects & Accounts -->
            <TabItem Header="📁 Projects &amp; Accounts">
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>

                    <!-- Projects List Card -->
                    <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Active Projects &amp; Accounts" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8" />

                            <!-- Toolbar -->
                            <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Style="{StaticResource SecondaryButton}" Command="{Binding ClearFormCommand}" Content="➕ New Project" Padding="8,4" FontSize="11" Margin="0,0,6,0" />
                                <Button Style="{StaticResource SecondaryButton}" Command="{Binding DeleteProjectCommand}" Content="🗑 Delete Selected" Padding="8,4" FontSize="11" Foreground="#EF4444" />
                            </WrapPanel>

                            <!-- Projects ListView -->
                            <ListView Grid.Row="2" ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}"
                                      Background="Transparent" BorderThickness="0"
                                      helpers:ScrollHelper.BubbleMouseWheel="True">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#162032" CornerRadius="6" Padding="12,10" Margin="0,0,0,6" BorderBrush="#253347" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="65" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Project Color Bar -->
                                                <Border Grid.Column="0" Width="4" CornerRadius="2" Background="{Binding ColorHex}" HorizontalAlignment="Left" />

                                                <!-- Project Code Badge -->
                                                <Border Grid.Column="1" Background="#0F172A" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Code}" FontWeight="Bold" Foreground="{Binding ColorHex}" FontSize="11" />
                                                </Border>

                                                <!-- Project Name & Description -->
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" />
                                                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>

                                                <!-- Active Indicator -->
                                                <Border Grid.Column="3" Background="#1E293B" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                                    <TextBlock Text="Active" Foreground="{StaticResource ActiveBrush}" FontSize="10" FontWeight="SemiBold" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>

                    <!-- Project Form Card -->
                    <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Project Details" FontSize="16" FontWeight="SemiBold" />
                                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Command="{Binding ClearFormCommand}" Content="Clear / New" FontSize="10" Padding="6,2" />
                                </Grid>

                                <TextBlock Text="Project Name (e.g. City Center Hospital)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                                <TextBlock Text="Project Code (e.g. CCH-2026, BIM)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding ProjectCode, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                                <!-- Color Preset Picker -->
                                <TextBlock Text="Color Tag" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <ItemsControl ItemsSource="{Binding ColorPresets}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Background="{Binding}" Width="24" Height="24" Margin="0,0,6,0" BorderThickness="0" Cursor="Hand"
                                                        Command="{Binding DataContext.SelectColorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="12" BorderBrush="#FFF" BorderThickness="1" />
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </WrapPanel>
                                <TextBox Text="{Binding ProjectColorHex, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                                <TextBlock Text="Description (Optional)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding ProjectDescription, UpdateSourceTrigger=PropertyChanged}" Height="50" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,16" />

                                <!-- Correlated Classification Rules -->
                                <TextBlock Text="Associated Classification Rules" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBlock Text="Select rules to link with this project from dropdown, or create a new rule:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,8" />

                                <!-- Multi-Check Rules Dropdown & New Rule Button -->
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Dropdown Toggle -->
                                    <ToggleButton x:Name="RulesDropdownToggle" 
                                                  Style="{StaticResource MultiCheckDropdownToggle}"
                                                  HorizontalContentAlignment="Stretch"
                                                  Padding="10,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding SelectedRulesSummaryText}" 
                                                       Foreground="{StaticResource TextPrimaryBrush}" 
                                                       FontSize="11" 
                                                       FontWeight="Medium"
                                                       TextTrimming="CharacterEllipsis" 
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="▼" 
                                                       Foreground="{StaticResource TextSecondaryBrush}" 
                                                       FontSize="9" 
                                                       VerticalAlignment="Center" 
                                                       Margin="8,0,0,0" />
                                        </Grid>
                                    </ToggleButton>

                                    <!-- Popup with Checkboxes -->
                                    <Popup PlacementTarget="{Binding ElementName=RulesDropdownToggle}" 
                                           IsOpen="{Binding IsChecked, ElementName=RulesDropdownToggle, Mode=TwoWay}" 
                                           StaysOpen="False" 
                                           AllowsTransparency="True" 
                                           PopupAnimation="Slide" 
                                           Placement="Bottom">
                                        <Border Width="{Binding ActualWidth, ElementName=RulesDropdownToggle}" 
                                                Background="#0F172A" 
                                                BorderBrush="{StaticResource BorderBrush}" 
                                                BorderThickness="1" 
                                                CornerRadius="6" 
                                                Padding="8" 
                                                MaxHeight="240">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="12" ShadowDepth="4" Direction="270" Opacity="0.5" Color="#000000" />
                                            </Border.Effect>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>

                                                <!-- Quick select toolbar -->
                                                <Grid Grid.Row="0" Margin="2,0,2,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Available Rules" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Command="{Binding SelectAllRulesCommand}" Content="Select All" Padding="6,2" FontSize="10" Margin="0,0,4,0" />
                                                    <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Command="{Binding ClearAllRulesCommand}" Content="Clear All" Padding="6,2" FontSize="10" />
                                                </Grid>

                                                <!-- Scrollable Checklist -->
                                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="180">
                                                    <ItemsControl ItemsSource="{Binding AvailableRules}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Padding="4,3" Margin="0,1" CornerRadius="4">
                                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Cursor="Hand">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock Text="{Binding RuleName}" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,6,0" />
                                                                            <TextBlock Text="{Binding SummaryText, StringFormat='({0})'}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                                                        </StackPanel>
                                                                    </CheckBox>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </Grid>
                                        </Border>
                                    </Popup>

                                    <!-- Button to open NewRuleDialog -->
                                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Command="{Binding OpenNewRuleDialogCommand}" Padding="10,8" Margin="8,0,0,0" ToolTip="Open dialog to create and link a new classification rule">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="➕" Margin="0,0,4,0" Foreground="{StaticResource AccentBrush}" />
                                            <TextBlock Text="New Rule" FontSize="11" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <Button Style="{StaticResource PrimaryButton}" Command="{Binding SaveProjectCommand}" Content="{Binding SaveButtonText}" HorizontalAlignment="Stretch" Padding="14,10" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 2: Categories -->
            <TabItem Header="🏷️ Categories">
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>

                    <!-- Categories List Card -->
                    <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Work Categories" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8" />

                            <!-- Toolbar -->
                            <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Style="{StaticResource SecondaryButton}" Command="{Binding ClearCategoryFormCommand}" Content="➕ New Category" Padding="8,4" FontSize="11" Margin="0,0,6,0" />
                                <Button Style="{StaticResource SecondaryButton}" Command="{Binding DeleteCategoryCommand}" Content="🗑 Delete Selected" Padding="8,4" FontSize="11" Foreground="#EF4444" />
                            </WrapPanel>

                            <!-- Categories ListView -->
                            <ListView Grid.Row="2" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                                      Background="Transparent" BorderThickness="0"
                                      helpers:ScrollHelper.BubbleMouseWheel="True">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#162032" CornerRadius="6" Padding="12,10" Margin="0,0,0,6" BorderBrush="#253347" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="32" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Color Bar -->
                                                <Border Grid.Column="0" Width="4" CornerRadius="2" Background="{Binding ColorHex}" HorizontalAlignment="Left" />

                                                <!-- Color Circle Badge -->
                                                <Border Grid.Column="1" Width="18" Height="18" CornerRadius="9" Background="{Binding ColorHex}" HorizontalAlignment="Left" VerticalAlignment="Center" />

                                                <!-- Name & Description -->
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="6,0">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" />
                                                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>

                                                <!-- Category Badge -->
                                                <Border Grid.Column="3" Background="#1E293B" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                                    <TextBlock Text="Category" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>

                    <!-- Category Form Card -->
                    <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Category Details" FontSize="16" FontWeight="SemiBold" />
                                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Command="{Binding ClearCategoryFormCommand}" Content="Clear / New" FontSize="10" Padding="6,2" />
                                </Grid>

                                <TextBlock Text="Category Name (e.g. BIM, Design, Admin, Meeting)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding CategoryName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                                <!-- Color Preset Picker -->
                                <TextBlock Text="Color Tag" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <ItemsControl ItemsSource="{Binding ColorPresets}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Background="{Binding}" Width="24" Height="24" Margin="0,0,6,0" BorderThickness="0" Cursor="Hand"
                                                        Command="{Binding DataContext.SelectCategoryColorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="12" BorderBrush="#FFF" BorderThickness="1" />
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </WrapPanel>
                                <TextBox Text="{Binding CategoryColorHex, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                                <TextBlock Text="Description (Optional)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding CategoryDescription, UpdateSourceTrigger=PropertyChanged}" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,16" />

                                <Button Style="{StaticResource PrimaryButton}" Command="{Binding SaveCategoryCommand}" Content="{Binding SaveCategoryButtonText}" HorizontalAlignment="Stretch" Padding="14,10" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 3: Tags -->
            <TabItem Header="🔖 Tags">
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>

                    <!-- Tags List Card -->
                    <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Work Activity Tags" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8" />

                            <!-- Toolbar -->
                            <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Style="{StaticResource SecondaryButton}" Command="{Binding ClearTagFormCommand}" Content="➕ New Tag" Padding="8,4" FontSize="11" Margin="0,0,6,0" />
                                <Button Style="{StaticResource SecondaryButton}" Command="{Binding DeleteTagCommand}" Content="🗑 Delete Selected" Padding="8,4" FontSize="11" Foreground="#EF4444" />
                            </WrapPanel>

                            <!-- Tags ListView -->
                            <ListView Grid.Row="2" ItemsSource="{Binding Tags}" SelectedItem="{Binding SelectedTag}"
                                      Background="Transparent" BorderThickness="0"
                                      helpers:ScrollHelper.BubbleMouseWheel="True">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#162032" CornerRadius="6" Padding="12,10" Margin="0,0,0,6" BorderBrush="#253347" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Tag Badge -->
                                                <Border Grid.Column="0" Background="#1E293B" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                                                    <TextBlock FontWeight="Bold" Foreground="{StaticResource AccentBrush}" FontSize="12">
                                                        <Run Text="#" Foreground="{StaticResource TextSecondaryBrush}" />
                                                        <Run Text="{Binding Name}" />
                                                    </TextBlock>
                                                </Border>

                                                <!-- Tag Description -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>

                    <!-- Tag Form Card -->
                    <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Tag Details" FontSize="16" FontWeight="SemiBold" />
                                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Command="{Binding ClearTagFormCommand}" Content="Clear / New" FontSize="10" Padding="6,2" />
                                </Grid>

                                <TextBlock Text="Tag Name (e.g. Revit, AutoCAD, 3D, Billable)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding TagName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                                <TextBlock Text="Description (Optional)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding TagDescription, UpdateSourceTrigger=PropertyChanged}" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,16" />

                                <Button Style="{StaticResource PrimaryButton}" Command="{Binding SaveTagCommand}" Content="{Binding SaveTagButtonText}" HorizontalAlignment="Stretch" Padding="14,10" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Status Message -->
        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Foreground="{StaticResource ActiveBrush}" Margin="0,8,0,0" FontSize="12" FontWeight="Medium" />
    </Grid>
</UserControl>
