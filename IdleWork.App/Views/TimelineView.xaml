<!-- [v0.2: TimelineView] Daily interactive timeline with multi-band ribbons & consolidated intervals -->
<UserControl x:Class="IdleWork.App.Views.TimelineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:helpers="clr-namespace:IdleWork.App.Core.Helpers"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1100">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Date Header & Navigation -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding PreviousDayCommand}" Content="◀" Width="36" Margin="0,0,6,0" />
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding NextDayCommand}" Content="▶" Width="36" Margin="0,0,12,0" />
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding TodayCommand}" Content="Today" Margin="0,0,16,0" />
                <TextBlock Text="{Binding DisplayDateText}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
            </StackPanel>

            <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" Content="🔄 Refresh" />
        </Grid>

        <!-- Daily Metrics Summary Bar -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="ACTIVE WORK TIME" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock Text="{Binding TotalActiveText}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource ActiveBrush}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="MEETINGS &amp; CALLS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock Text="{Binding TotalMeetingText}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource MeetingBrush}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="IDLE / BREAKS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock Text="{Binding TotalIdleText}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource IdleBrush}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="6" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="UNTRACKED / OFFLINE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock Text="{Binding TotalOfflineText}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- [v0.2: TimelineRibbons] Visual Timeline Ribbon (Trackabi / ActivityWatch Style) -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,0,0,16" Padding="14,12">
            <StackPanel>
                <!-- Time Axis Labels -->
                <Grid Margin="120,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="00:00" FontSize="9" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock Grid.Column="1" Text="04:00" FontSize="9" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock Grid.Column="2" Text="08:00" FontSize="9" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock Grid.Column="3" Text="12:00" FontSize="9" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock Grid.Column="4" Text="16:00" FontSize="9" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock Grid.Column="5" Text="20:00" FontSize="9" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock Grid.Column="6" Text="24:00" FontSize="9" Foreground="{StaticResource TextMutedBrush}" />
                </Grid>

                <!-- Lane 1: Computer Usage (Active / Meeting / Idle) -->
                <Grid Margin="0,2,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Computer Usage" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    <Border Grid.Column="1" Height="14" CornerRadius="3" Background="#0F172A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <ItemsControl ItemsSource="{Binding UsageSegments}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding LeftRatio, Converter={x:Static helpers:CanvasRatioConverter.Instance}}" />
                                    <Setter Property="Width" Value="{Binding WidthRatio, Converter={x:Static helpers:CanvasRatioConverter.Instance}}" />
                                    <Setter Property="Height" Value="12" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Rectangle Fill="{Binding ColorHex}" ToolTip="{Binding ToolTipText}" RadiusX="2" RadiusY="2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </Grid>

                <!-- Lane 2: Applications -->
                <Grid Margin="0,2,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Applications" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    <Border Grid.Column="1" Height="14" CornerRadius="3" Background="#0F172A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <ItemsControl ItemsSource="{Binding AppSegments}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding LeftRatio, Converter={x:Static helpers:CanvasRatioConverter.Instance}}" />
                                    <Setter Property="Width" Value="{Binding WidthRatio, Converter={x:Static helpers:CanvasRatioConverter.Instance}}" />
                                    <Setter Property="Height" Value="12" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Rectangle Fill="{Binding ColorHex}" ToolTip="{Binding ToolTipText}" RadiusX="2" RadiusY="2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </Grid>

                <!-- Lane 3: Documents -->
                <Grid Margin="0,2,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Documents" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    <Border Grid.Column="1" Height="14" CornerRadius="3" Background="#0F172A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <ItemsControl ItemsSource="{Binding DocSegments}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding LeftRatio, Converter={x:Static helpers:CanvasRatioConverter.Instance}}" />
                                    <Setter Property="Width" Value="{Binding WidthRatio, Converter={x:Static helpers:CanvasRatioConverter.Instance}}" />
                                    <Setter Property="Height" Value="12" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Rectangle Fill="{Binding ColorHex}" ToolTip="{Binding ToolTipText}" RadiusX="2" RadiusY="2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Main Timeline & Quick Tagging Grid -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- Consolidated Activities List Card -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Consolidated Daily Activities" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="Grouped by App &amp; Document" Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Activities List with Expandable Interval Drawers -->
                    <ListView Grid.Row="1" ItemsSource="{Binding Activities}" SelectedItem="{Binding SelectedActivity}"
                              Background="Transparent" BorderThickness="0"
                              helpers:ScrollHelper.BubbleMouseWheel="True">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#162032" CornerRadius="6" Padding="12,10" Margin="0,0,0,6" BorderBrush="#253347" BorderThickness="1">
                                    <StackPanel>
                                        <!-- Top Row: Summary -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="65" />
                                                <ColumnDefinition Width="70" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Expand / Collapse Toggle -->
                                            <Button Grid.Column="0" Command="{Binding ToggleExpandCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="2" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding IsExpanded, Converter={x:Static helpers:BoolToArrowConverter.Instance}}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                                            </Button>

                                            <!-- Time Range -->
                                            <TextBlock Grid.Column="1" Text="{Binding TimeSpanRangeText}" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" FontSize="11" />

                                            <!-- Process Badge -->
                                            <Border Grid.Column="2" Background="#1E293B" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ProcessName}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" FontSize="11" />
                                            </Border>

                                            <!-- Window Title & Document -->
                                            <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="6,0">
                                                <TextBlock Text="{Binding WindowTitle}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="Medium" />
                                                <TextBlock Text="{Binding SubActivityDisplay}" Foreground="{StaticResource MeetingBrush}" FontSize="10" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <!-- Project Badge -->
                                            <Border Grid.Column="4" Background="#0F172A" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ProjectName, TargetNullValue='Unassigned'}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                                            </Border>

                                            <!-- Percentage of Day Pill -->
                                            <Border Grid.Column="5" Background="#1E293B" CornerRadius="4" Padding="4,2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding PercentageText}" Foreground="{StaticResource ActiveBrush}" FontSize="10" FontWeight="Bold" />
                                            </Border>

                                            <!-- Total Duration -->
                                            <TextBlock Grid.Column="6" Text="{Binding DisplayDuration}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" />
                                        </Grid>

                                        <!-- Expanded Drawer: All Discrete Session Intervals -->
                                        <Border Margin="28,8,0,0" Padding="10,8" Background="#0F172A" CornerRadius="4" BorderBrush="#253347" BorderThickness="1"
                                                Visibility="{Binding IsExpanded, Converter={x:Static helpers:BoolToVisibilityConverter.Instance}}">
                                            <StackPanel>
                                                <TextBlock Text="Discrete Session Intervals &amp; Concurrent Secondary Windows:" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" />
                                                <ItemsControl ItemsSource="{Binding Intervals}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,2">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="130" />
                                                                    <ColumnDefinition Width="90" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding TimeRangeText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                                                                <TextBlock Grid.Column="1" Text="{Binding DisplayDuration}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" />
                                                                <TextBlock Grid.Column="2" Text="{Binding SubProcessName, StringFormat='Sub: {0}'}" Foreground="{StaticResource MeetingBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- 1-Click "Assign & Remember" Rule Panel -->
            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Assign Activity" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock Text="Assign a classification rule or direct project to the selected activity." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,16" TextWrapping="Wrap" />

                        <!-- Selected Activity Details -->
                        <Border Background="#0F172A" CornerRadius="6" Padding="12" Margin="0,0,0,16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="SELECTED ACTIVITY" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding SelectedActivity.ProcessName, TargetNullValue='(Select an activity from list)'}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                                <TextBlock Text="{Binding SelectedActivity.WindowTitle}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,2,0,4" />
                                <TextBlock Text="{Binding SelectedActivity.DisplayDuration, StringFormat='Total Duration: {0}'}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                            </StackPanel>
                        </Border>

                        <!-- Assignment Mode Radio Buttons -->
                        <TextBlock Text="Assign via:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <RadioButton Content="Classification Rule" IsChecked="{Binding IsAssignByRule, Mode=TwoWay}" GroupName="AssignModeRadio" 
                                         Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" Margin="0,0,16,0" Cursor="Hand" />
                            <RadioButton Content="Direct Project" IsChecked="{Binding IsAssignByProject, Mode=TwoWay}" GroupName="AssignModeRadio" 
                                         Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" Cursor="Hand" />
                        </StackPanel>

                        <!-- Dynamic Target Dropdown with Create New Action Row -->
                        <TextBlock Text="{Binding DropdownLabelText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" ItemsSource="{Binding AssignmentChoices}" SelectedItem="{Binding SelectedChoice}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="2,3" Margin="0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCreateAction}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,1,0,0" />
                                                </StackPanel>
                                                <Border Grid.Column="1" Background="#0F172A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="8,0,0,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCreateAction}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="NEW" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Command="{Binding CreateNewCommand}" Padding="10,6" Margin="8,0,0,0" ToolTip="Open dialog to create new rule or project">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="➕" Margin="0,0,4,0" Foreground="{StaticResource AccentBrush}" />
                                    <TextBlock Text="New" FontSize="12" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Notice when no rules match current application -->
                        <Border Background="#2A1B0E" BorderBrush="{StaticResource MeetingBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,12"
                                Visibility="{Binding HasNoApplicableRules, Converter={x:Static helpers:BoolToVisibilityConverter.Instance}}">
                            <TextBlock Text="{Binding NoRulesMessageText}" Foreground="{StaticResource MeetingBrush}" FontSize="11" TextWrapping="Wrap" />
                        </Border>

                        <!-- Options -->
                        <CheckBox Content="Remember this rule for future activities" IsChecked="{Binding RememberRule}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"
                                  Visibility="{Binding IsAssignByProject, Converter={x:Static helpers:BoolToVisibilityConverter.Instance}}" />
                        <CheckBox Content="Apply retroactively to past 7 days" IsChecked="{Binding ApplyRetroactively}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,20" />

                        <!-- Action Button -->
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding AssignProjectCommand}" Content="Save &amp; Apply" HorizontalAlignment="Stretch" Padding="14,10" />

                        <!-- Feedback message -->
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource ActiveBrush}" Margin="0,16,0,0" FontSize="12" TextWrapping="Wrap" FontWeight="Medium" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
