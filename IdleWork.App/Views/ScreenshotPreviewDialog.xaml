<Window x:Class="IdleWork.App.Views.ScreenshotPreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Visual Evidence &amp; Screenshot Preview"
        Width="1100" Height="750"
        MinWidth="650" MinHeight="450"
        WindowStartupLocation="CenterScreen"
        Background="#0B0F19"
        Foreground="{StaticResource TextPrimaryBrush}"
        WindowStyle="None"
        AllowsTransparency="True"
        BorderBrush="{StaticResource AccentBrush}"
        BorderThickness="1"
        ResizeMode="CanResizeWithGrip">

    <Border Background="#0F172A" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#1E293B" Padding="16,10" CornerRadius="8,8,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" MouseDown="Header_MouseDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📸" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TxtAppDescription" Text="Application Name" FontWeight="Bold" FontSize="14" Foreground="{StaticResource AccentBrush}" />
                                <TextBlock x:Name="TxtTimestamp" Text=" • 2026-09-29 14:30:00" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="6,0,0,0" />
                            </StackPanel>
                            <TextBlock x:Name="TxtWindowTitle" Text="Window Title Here" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" MaxWidth="700" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Click="Maximize_Click" Style="{StaticResource SecondaryButton}" Content="🗖" Width="32" Height="32" Padding="0" FontSize="12" Margin="0,0,6,0" ToolTip="Maximize / Restore" />
                        <Button Click="Close_Click" Style="{StaticResource SecondaryButton}" Content="✕" Width="32" Height="32" Padding="0" FontSize="14" ToolTip="Close (Esc)" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Image Viewer: Automatically resized to fit the window dimensions -->
            <Border Grid.Row="1" Background="#020617" Margin="12" CornerRadius="6" BorderBrush="#1E293B" BorderThickness="1" ClipToBounds="True">
                <Grid>
                    <!-- Fit to Window Mode (Default): Direct Grid forces Stretch="Uniform" to fit perfectly inside the window -->
                    <Image x:Name="ImgPreviewFit" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />

                    <!-- 100% Original Size Mode (Scrollable) -->
                    <ScrollViewer x:Name="ScrollOriginal" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <Image x:Name="ImgPreviewOriginal" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Footer Bar -->
            <Border Grid.Row="2" Background="#162032" Padding="16,10" CornerRadius="0,0,8,8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="File: " Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                        <TextBlock x:Name="TxtFilePath" Text="" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="500" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="BtnToggleViewMode" Click="ToggleViewMode_Click" Style="{StaticResource SecondaryButton}" Content="🔍 1:1 Actual Size" Margin="0,0,8,0" ToolTip="Switch between Fit to Window and 100% Actual Size" />
                        <Button Click="OpenInDefaultViewer_Click" Style="{StaticResource SecondaryButton}" Content="🖼️ Open in Photos" Margin="0,0,8,0" />
                        <Button Click="OpenFolder_Click" Style="{StaticResource SecondaryButton}" Content="📂 Open Folder" Margin="0,0,8,0" />
                        <Button Click="Close_Click" Style="{StaticResource PrimaryButton}" Content="Close" Width="80" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
