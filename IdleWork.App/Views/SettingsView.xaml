<!-- [v0.1: SettingsView] Settings and diagnostic preferences UI -->
<UserControl x:Class="IdleWork.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="850">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="750" HorizontalAlignment="Left">
            
            <TextBlock Text="Preferences &amp; Diagnostics" FontSize="20" FontWeight="Bold" Margin="0,0,0,4" />
            <TextBlock Text="Configure tracking thresholds, idle timeouts, and local database settings." Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,0,0,24" />

            <!-- Inactivity Card -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="INACTIVITY &amp; IDLE SENSING" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12" />

                    <!-- Idle Timeout Slider -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Idle Timeout Threshold" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Text="Inactivity duration before entering Idle mode (30s, 1 min, or 1-min intervals)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding IdleTimeoutDisplayText}" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" FontSize="14" VerticalAlignment="Center" />
                            <Border Background="#0F172A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Default: 3 min" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                            </Border>
                            <Button Style="{StaticResource SecondaryButton}" Command="{Binding ResetIdleTimeoutCommand}" ToolTip="Reset to default (3 minutes)" Padding="8,3" Margin="8,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="↺" FontWeight="Bold" Margin="0,0,4,0" Foreground="{StaticResource AccentBrush}" />
                                    <TextBlock Text="Reset" FontSize="11" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Slider Minimum="30" Maximum="900" Value="{Binding IdleTimeoutSeconds}" 
                            Ticks="30,60,120,180,240,300,360,420,480,540,600,660,720,780,840,900" 
                            TickPlacement="BottomRight" IsSnapToTickEnabled="True" 
                            Foreground="{StaticResource AccentBrush}" Cursor="Hand" Margin="0,0,0,4" />
                    <!-- Default Marker & Range Legend -->
                    <Grid Margin="4,0,4,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150*" />
                            <ColumnDefinition Width="720*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="30s" FontSize="10" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Left" />
                        <StackPanel Grid.Column="0" HorizontalAlignment="Right" Margin="0,0,-26,0">
                            <Border Background="#0F172A" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="3" Padding="4,1">
                                <TextBlock Text="▲ Default (3 min)" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="15 min" FontSize="10" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" />
                    </Grid>

                    <!-- Dwell Debounce Slider -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Dwell Debounce Filter" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Text="Minimum seconds in a window before recording (filters rapid Alt-Tabs)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DwellDebounceSeconds, StringFormat='{}{0:F1}s'}" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" FontSize="14" VerticalAlignment="Center" />
                            <Border Background="#0F172A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Default: 2.5s" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                            </Border>
                            <Button Style="{StaticResource SecondaryButton}" Command="{Binding ResetDwellDebounceCommand}" ToolTip="Reset to default (2.5s)" Padding="8,3" Margin="8,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="↺" FontWeight="Bold" Margin="0,0,4,0" Foreground="{StaticResource AccentBrush}" />
                                    <TextBlock Text="Reset" FontSize="11" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Slider Minimum="1.0" Maximum="5.0" Value="{Binding DwellDebounceSeconds}" 
                            Ticks="1.0, 1.5, 2.0, 2.5, 3.0, 3.5, 4.0, 4.5, 5.0" 
                            TickPlacement="BottomRight" IsSnapToTickEnabled="True" 
                            Foreground="{StaticResource AccentBrush}" Cursor="Hand" Margin="0,0,0,4" />
                    <!-- Default Marker & Range Legend -->
                    <Grid Margin="4,0,4,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="2.5*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="1.0s" FontSize="10" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Left" />
                        <StackPanel Grid.Column="0" HorizontalAlignment="Right" Margin="0,0,-24,0">
                            <Border Background="#0F172A" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="3" Padding="4,1">
                                <TextBlock Text="▲ Default (2.5s)" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="5.0s" FontSize="10" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Audio & Meeting Mode Card -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="MICROPHONE &amp; MEETING MODE" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Microphone Sensitivity Threshold" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Text="Hardware audio volume peak required to trigger Meeting Mode (100% passive, no audio recorded)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding MicSensitivity, StringFormat='{}{0:P0}'}" FontWeight="Bold" Foreground="{StaticResource MeetingBrush}" FontSize="14" VerticalAlignment="Center" />
                            <Border Background="#0F172A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Default: 5%" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                            </Border>
                            <Button Style="{StaticResource SecondaryButton}" Command="{Binding ResetMicSensitivityCommand}" ToolTip="Reset to default (5%)" Padding="8,3" Margin="8,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="↺" FontWeight="Bold" Margin="0,0,4,0" Foreground="{StaticResource MeetingBrush}" />
                                    <TextBlock Text="Reset" FontSize="11" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Slider Minimum="0.01" Maximum="0.25" Value="{Binding MicSensitivity}" 
                            Ticks="0.01, 0.03, 0.05, 0.07, 0.10, 0.15, 0.20, 0.25" 
                            TickPlacement="BottomRight" IsSnapToTickEnabled="True" 
                            Foreground="{StaticResource MeetingBrush}" Cursor="Hand" Margin="0,0,0,4" />
                    <!-- Default Marker & Range Legend -->
                    <Grid Margin="4,0,4,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.04*" />
                            <ColumnDefinition Width="0.20*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="1%" FontSize="10" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Left" />
                        <StackPanel Grid.Column="0" HorizontalAlignment="Right" Margin="0,0,-22,0">
                            <Border Background="#0F172A" BorderBrush="{StaticResource MeetingBrush}" BorderThickness="1" CornerRadius="3" Padding="4,1">
                                <TextBlock Text="▲ Default (5%)" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource MeetingBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="25%" FontSize="10" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Local SQLite Database Card -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="LOCAL SQLITE PERSISTENCE" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12" />
                    
                    <TextBlock Text="Database File Location" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding DatabasePath}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,12" TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource SecondaryButton}" Command="{Binding OpenDatabaseFolderCommand}" Content="📂 Open Local Database Folder" Margin="0,0,12,0" />
                    </StackPanel>

                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource ActiveBrush}" FontSize="12" Margin="0,12,0,0" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
