<!-- [v0.2: RulesManagerView] Smart auto-tag rules manager & Primary Software Priority Hierarchy -->
<UserControl x:Class="IdleWork.App.Views.RulesManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:helpers="clr-namespace:IdleWork.App.Core.Helpers"
             mc:Ignorable="d" 
             d:DesignHeight="780" d:DesignWidth="1050">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Smart Rules &amp; Software Priority" FontSize="20" FontWeight="Bold" />
                <TextBlock Text="Define automated rules, project tagging, and primary software priority across all display monitors." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" Content="🔄 Refresh All" />
        </Grid>

        <!-- Main Tab Control -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Padding" Value="14,8" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="tabBorder" Background="{TemplateBinding Background}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,2" Margin="0,0,8,0" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter ContentSource="Header" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="tabBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- TAB 1: Smart Auto-Tag Rules -->
            <TabItem Header="🏷️ Auto-Classification Rules">
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Rules List with Toolbar -->
                    <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Active Classification Rules (Priority Order)" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />

                            <!-- [v0.2: SmartRulesMultiSelect] Toolbar: Move Up, Down, Duplicate, Toggle Enable, Delete (supporting multi-selection) -->
                            <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Style="{StaticResource SecondaryButton}" Command="{Binding MoveUpCommand}" CommandParameter="{Binding SelectedItems, ElementName=RulesListView}" Content="⬆ Move Up" Padding="8,4" FontSize="11" Margin="0,0,6,4" ToolTip="Shift selected rule(s) higher in priority" />
                                <Button Style="{StaticResource SecondaryButton}" Command="{Binding MoveDownCommand}" CommandParameter="{Binding SelectedItems, ElementName=RulesListView}" Content="⬇ Move Down" Padding="8,4" FontSize="11" Margin="0,0,6,4" ToolTip="Shift selected rule(s) lower in priority" />
                                <Button Style="{StaticResource SecondaryButton}" Command="{Binding DuplicateRuleCommand}" CommandParameter="{Binding SelectedItems, ElementName=RulesListView}" Content="📄 Duplicate" Padding="8,4" FontSize="11" Margin="0,0,6,4" ToolTip="Clone selected rule(s)" />
                                <Button Style="{StaticResource SecondaryButton}" Command="{Binding ToggleEnableCommand}" CommandParameter="{Binding SelectedItems, ElementName=RulesListView}" Content="🔘 Toggle Enable" Padding="8,4" FontSize="11" Margin="0,0,6,4" ToolTip="Toggle enabled/disabled state for selected rule(s)" />
                                <Button Style="{StaticResource SecondaryButton}" Command="{Binding DeleteRuleCommand}" CommandParameter="{Binding SelectedItems, ElementName=RulesListView}" Content="🗑 Delete" Padding="8,4" FontSize="11" Margin="0,0,6,4" Foreground="#EF4444" ToolTip="Delete selected rule(s)" />
                            </WrapPanel>

                            <!-- [v0.2: SmartRulesMultiSelect] Rules ListView with Extended multi-selection, Auto-Edit mode, and Fluent container style -->
                            <ListView x:Name="RulesListView" Grid.Row="2" ItemsSource="{Binding Rules}" SelectedItem="{Binding SelectedRule}" 
                                      SelectionMode="Extended"
                                      SelectionChanged="RulesListView_SelectionChanged"
                                      Background="Transparent" BorderThickness="0"
                                      helpers:ScrollHelper.BubbleMouseWheel="True">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,0,0,6" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListViewItem">
                                                    <Border x:Name="ContainerBorder" Background="#162032" BorderBrush="#253347" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ContainerBorder" Property="Background" Value="#1E293B" />
                                                            <Setter TargetName="ContainerBorder" Property="BorderBrush" Value="#334155" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="ContainerBorder" Property="Background" Value="#1E2D4A" />
                                                            <Setter TargetName="ContainerBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                            <Setter TargetName="ContainerBorder" Property="BorderThickness" Value="1.5" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="35" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="{Binding Priority}" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" FontSize="12" />

                                            <StackPanel Grid.Column="1" Margin="8,0">
                                                <TextBlock Text="{Binding RuleName}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" />
                                                <TextBlock Text="{Binding ProcessFilter, StringFormat='Process: {0}'}" Foreground="{StaticResource AccentHoverBrush}" FontSize="11" />
                                                <TextBlock Text="{Binding TitlePattern, StringFormat='Title: {0}'}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                                            </StackPanel>

                                            <Border Grid.Column="2" Background="#0F172A" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding TargetProject}" FontWeight="SemiBold" Foreground="{StaticResource ActiveBrush}" FontSize="11" />
                                                    <TextBlock Text="{Binding TargetCategory}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" />
                                                </StackPanel>
                                            </Border>

                                            <CheckBox Grid.Column="3" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <!-- Retroactive Batch Button -->
                            <Button Grid.Row="3" Style="{StaticResource SecondaryButton}" Command="{Binding RunRetroactiveBatchCommand}" Content="⚡ Run Retroactive Batch (Past 14 Days)" Margin="0,10,0,0" HorizontalAlignment="Left" />
                        </Grid>
                    </Border>

                    <!-- Right: Add / Edit Form Card -->
                    <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Rule Configuration" FontSize="16" FontWeight="SemiBold" />
                                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Command="{Binding CancelEditCommand}" Content="Clear / New" FontSize="10" Padding="6,2" />
                                </Grid>

                                <TextBlock Text="Rule Name" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding NewRuleName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                                <TextBlock Text="Application Process (e.g. Revit, acad, devenv)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding NewProcessFilter, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                                <TextBlock Text="Window Title Pattern / Keyword (Optional)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2" />
                                <TextBlock Text="Matches text inside the active window title (e.g. 'Hospital', 'Floor Plan', 'Project-101'). Case-insensitive. Leave empty or '*' to match all windows of this application." 
                                           FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                <TextBox Text="{Binding NewTitlePattern, UpdateSourceTrigger=PropertyChanged}" 
                                         ToolTip="Case-insensitive title substring. E.g. 'Hospital' matches 'AutoCAD - Hospital Level 1.dwg'. Leave blank for any window." 
                                         Margin="0,0,0,10" />

                                <TextBlock Text="Target Project" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding AvailableProjects}" SelectedValue="{Binding NewTargetProject}" SelectedValuePath="Name" DisplayMemberPath="Name" Margin="0,0,0,10" />

                                <TextBlock Text="Category" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <ComboBox IsEditable="True"
                                          ItemsSource="{Binding AvailableCategories}"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Name"
                                          Text="{Binding NewTargetCategory, UpdateSourceTrigger=PropertyChanged}"
                                          Margin="0,0,0,10" />

                                <TextBlock Text="Tags (e.g. Revit, 3D, Billable)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <ComboBox IsEditable="True"
                                          ItemsSource="{Binding AvailableTags}"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Name"
                                          Text="{Binding NewTargetTags, UpdateSourceTrigger=PropertyChanged}"
                                          Margin="0,0,0,16" />

                                <Button Style="{StaticResource PrimaryButton}" Command="{Binding SaveRuleCommand}" Content="{Binding SaveButtonText}" HorizontalAlignment="Stretch" Padding="14,10" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 2: Primary Software Priority Hierarchy -->
            <TabItem Header="⭐ Primary Software Priority (Multi-Monitor)">
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Priorities List -->
                    <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="Work Software Priority Ranking" FontWeight="SemiBold" FontSize="15" />
                                <TextBlock Text="The topmost visible application with the highest priority across all monitors defines the Main Activity. Switching focus to a secondary screen (e.g. PDF viewer or AutoCAD) will NOT interrupt your Main Activity, but will record a concurrent Sub-Activity." Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>

                            <!-- [v0.2: SmartRulesMultiSelect] Toolbar: Move Up, Down, Delete (multi-select enabled) -->
                            <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,10">
                                <Button Style="{StaticResource SecondaryButton}" Command="{Binding MovePrioUpCommand}" CommandParameter="{Binding SelectedItems, ElementName=PrioritiesListView}" Content="⬆ Promote (Higher Prio)" Padding="8,4" FontSize="11" Margin="0,0,6,0" />
                                <Button Style="{StaticResource SecondaryButton}" Command="{Binding MovePrioDownCommand}" CommandParameter="{Binding SelectedItems, ElementName=PrioritiesListView}" Content="⬇ Demote (Lower Prio)" Padding="8,4" FontSize="11" Margin="0,0,6,0" />
                                <Button Style="{StaticResource SecondaryButton}" Command="{Binding DeletePriorityCommand}" CommandParameter="{Binding SelectedItems, ElementName=PrioritiesListView}" Content="🗑 Remove" Padding="8,4" FontSize="11" Foreground="#EF4444" />
                            </WrapPanel>

                            <!-- [v0.2: SmartRulesMultiSelect] Priority ListView with Extended multi-selection -->
                            <ListView x:Name="PrioritiesListView" Grid.Row="2" ItemsSource="{Binding SoftwarePriorities}" SelectedItem="{Binding SelectedPriority}" 
                                      SelectionMode="Extended"
                                      Background="Transparent" BorderThickness="0"
                                      helpers:ScrollHelper.BubbleMouseWheel="True">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,0,0,6" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListViewItem">
                                                    <Border x:Name="ContainerBorder" Background="#162032" BorderBrush="#253347" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ContainerBorder" Property="Background" Value="#1E293B" />
                                                            <Setter TargetName="ContainerBorder" Property="BorderBrush" Value="#334155" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="ContainerBorder" Property="Background" Value="#1E2D4A" />
                                                            <Setter TargetName="ContainerBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                            <Setter TargetName="ContainerBorder" Property="BorderThickness" Value="1.5" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="50" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="120" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Rank Badge -->
                                            <Border Background="#1E293B" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Priority, StringFormat='Prio {0}'}" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" FontSize="11" />
                                            </Border>

                                            <!-- Display Name & Process -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" />
                                                <TextBlock Text="{Binding ProcessFilter, StringFormat='Process: {0}'}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                                            </StackPanel>

                                            <!-- Active Tag -->
                                            <TextBlock Grid.Column="2" Text="Active Work App" Foreground="{StaticResource ActiveBrush}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>

                    <!-- Right: Add Priority Software Form -->
                    <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="Add Primary Work App" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBlock Text="Add applications that should take precedence as your Main Activity whenever visible on any screen." Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,16" />

                            <TextBlock Text="Process Name (e.g. Revit, acad, devenv, Rhino)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding NewPrioProcess, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                            <TextBlock Text="Display Name (e.g. Autodesk Revit, AutoCAD, Visual Studio)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding NewPrioDisplayName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,20" />

                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding AddPriorityCommand}" Content="+ Add Priority Software" HorizontalAlignment="Stretch" Padding="14,10" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 3: Categories -->
            <TabItem Header="🏷️ Categories">
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>

                    <!-- Categories List Card -->
                    <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Work Categories" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8" />

                            <!-- Toolbar -->
                            <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Style="{StaticResource SecondaryButton}" Command="{Binding ClearCategoryFormCommand}" Content="➕ New Category" Padding="8,4" FontSize="11" Margin="0,0,6,0" />
                                <Button Style="{StaticResource SecondaryButton}" Command="{Binding DeleteCategoryCommand}" Content="🗑 Delete Selected" Padding="8,4" FontSize="11" Foreground="#EF4444" />
                            </WrapPanel>

                            <!-- Categories ListView -->
                            <ListView Grid.Row="2" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                                      Background="Transparent" BorderThickness="0"
                                      helpers:ScrollHelper.BubbleMouseWheel="True">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#162032" CornerRadius="6" Padding="12,10" Margin="0,0,0,6" BorderBrush="#253347" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="32" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Color Bar -->
                                                <Border Grid.Column="0" Width="4" CornerRadius="2" Background="{Binding ColorHex}" HorizontalAlignment="Left" />

                                                <!-- Color Circle Badge -->
                                                <Border Grid.Column="1" Width="18" Height="18" CornerRadius="9" Background="{Binding ColorHex}" HorizontalAlignment="Left" VerticalAlignment="Center" />

                                                <!-- Name & Description -->
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="6,0">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" />
                                                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>

                                                <!-- Category Badge -->
                                                <Border Grid.Column="3" Background="#1E293B" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                                    <TextBlock Text="Category" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>

                    <!-- Category Form Card -->
                    <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Category Details" FontSize="16" FontWeight="SemiBold" />
                                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Command="{Binding ClearCategoryFormCommand}" Content="Clear / New" FontSize="10" Padding="6,2" />
                                </Grid>

                                <TextBlock Text="Category Name (e.g. BIM, Design, Admin, Meeting)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding CategoryName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                                <!-- Color Preset Picker -->
                                <TextBlock Text="Color Tag" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <ItemsControl ItemsSource="{Binding ColorPresets}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Background="{Binding}" Width="24" Height="24" Margin="0,0,6,0" BorderThickness="0" Cursor="Hand"
                                                        Command="{Binding DataContext.SelectCategoryColorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="12" BorderBrush="#FFF" BorderThickness="1" />
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </WrapPanel>
                                <TextBox Text="{Binding CategoryColorHex, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                                <TextBlock Text="Description (Optional)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding CategoryDescription, UpdateSourceTrigger=PropertyChanged}" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,16" />

                                <Button Style="{StaticResource PrimaryButton}" Command="{Binding SaveCategoryCommand}" Content="{Binding SaveCategoryButtonText}" HorizontalAlignment="Stretch" Padding="14,10" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 4: Tags -->
            <TabItem Header="🔖 Tags">
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>

                    <!-- Tags List Card -->
                    <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Work Activity Tags" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8" />

                            <!-- Toolbar -->
                            <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Style="{StaticResource SecondaryButton}" Command="{Binding ClearTagFormCommand}" Content="➕ New Tag" Padding="8,4" FontSize="11" Margin="0,0,6,0" />
                                <Button Style="{StaticResource SecondaryButton}" Command="{Binding DeleteTagCommand}" Content="🗑 Delete Selected" Padding="8,4" FontSize="11" Foreground="#EF4444" />
                            </WrapPanel>

                            <!-- Tags ListView -->
                            <ListView Grid.Row="2" ItemsSource="{Binding Tags}" SelectedItem="{Binding SelectedTag}"
                                      Background="Transparent" BorderThickness="0"
                                      helpers:ScrollHelper.BubbleMouseWheel="True">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#162032" CornerRadius="6" Padding="12,10" Margin="0,0,0,6" BorderBrush="#253347" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Tag Badge -->
                                                <Border Grid.Column="0" Background="#1E293B" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                                                    <TextBlock FontWeight="Bold" Foreground="{StaticResource AccentBrush}" FontSize="12">
                                                        <Run Text="#" Foreground="{StaticResource TextSecondaryBrush}" />
                                                        <Run Text="{Binding Name}" />
                                                    </TextBlock>
                                                </Border>

                                                <!-- Tag Description -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>

                    <!-- Tag Form Card -->
                    <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Tag Details" FontSize="16" FontWeight="SemiBold" />
                                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Command="{Binding ClearTagFormCommand}" Content="Clear / New" FontSize="10" Padding="6,2" />
                                </Grid>

                                <TextBlock Text="Tag Name (e.g. Revit, AutoCAD, 3D, Billable)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding TagName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                                <TextBlock Text="Description (Optional)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding TagDescription, UpdateSourceTrigger=PropertyChanged}" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,16" />

                                <Button Style="{StaticResource PrimaryButton}" Command="{Binding SaveTagCommand}" Content="{Binding SaveTagButtonText}" HorizontalAlignment="Stretch" Padding="14,10" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Status Message -->
        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Foreground="{StaticResource ActiveBrush}" Margin="0,8,0,0" FontSize="12" FontWeight="Medium" />
    </Grid>
</UserControl>
