<!-- [v0.2: NewProjectDialog] Modal dialog for quickly creating projects and correlating rules from the Daily Timeline -->
<Window x:Class="IdleWork.App.Views.NewProjectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create New Project"
        Height="590" Width="510"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BgDarkBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="8" Padding="14" Margin="0,0,0,14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Create New Project" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                <TextBlock Text="Define a project name, color, and correlate classification rules at creation." Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,2,0,0" />
            </StackPanel>
        </Border>

        <!-- Form -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Project Name *" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" />
                    <TextBox x:Name="NameTextBox" Margin="0,0,0,10" />

                    <TextBlock Text="Project Code" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" />
                    <TextBox x:Name="CodeTextBox" Margin="0,0,0,10" />

                    <TextBlock Text="Color Accent" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button x:Name="ColorBtn1" Background="#3B82F6" Width="26" Height="26" Margin="0,0,6,0" Click="ColorChip_Click" Tag="#3B82F6" Cursor="Hand" />
                        <Button x:Name="ColorBtn2" Background="#10B981" Width="26" Height="26" Margin="0,0,6,0" Click="ColorChip_Click" Tag="#10B981" Cursor="Hand" />
                        <Button x:Name="ColorBtn3" Background="#8B5CF6" Width="26" Height="26" Margin="0,0,6,0" Click="ColorChip_Click" Tag="#8B5CF6" Cursor="Hand" />
                        <Button x:Name="ColorBtn4" Background="#F59E0B" Width="26" Height="26" Margin="0,0,6,0" Click="ColorChip_Click" Tag="#F59E0B" Cursor="Hand" />
                        <Button x:Name="ColorBtn5" Background="#EC4899" Width="26" Height="26" Margin="0,0,6,0" Click="ColorChip_Click" Tag="#EC4899" Cursor="Hand" />
                        <Button x:Name="ColorBtn6" Background="#06B6D4" Width="26" Height="26" Margin="0,0,6,0" Click="ColorChip_Click" Tag="#06B6D4" Cursor="Hand" />
                        <TextBox x:Name="ColorTextBox" Text="#3B82F6" Width="80" VerticalAlignment="Center" Margin="6,0,0,0" FontSize="11" />
                    </StackPanel>

                    <TextBlock Text="Description (Optional)" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" />
                    <TextBox x:Name="DescTextBox" Height="38" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,12" />

                    <!-- Correlated Rules Section -->
                    <TextBlock Text="Correlate Classification Rules" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" />
                    <TextBlock Text="Select existing rules to link or define a new rule right now:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,6" />

                    <Border Background="#0F172A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" MaxHeight="90" Margin="0,0,0,8" Padding="6">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="RulesItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="2,2" Cursor="Hand">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding RuleName}" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,6,0" />
                                                <TextBlock Text="{Binding SummaryText, StringFormat='({0})'}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                            </StackPanel>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <!-- Quick Add Rule Inline -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="QuickRuleProcessTextBox" ToolTip="Process (e.g. Revit)" FontSize="11" />
                        <TextBox Grid.Column="2" x:Name="QuickRuleTitleTextBox" ToolTip="Title keyword (e.g. Hospital)" FontSize="11" />
                        <Button Grid.Column="4" Style="{StaticResource SecondaryButton}" Content="➕ Add Rule" Click="AddQuickRule_Click" Padding="6,3" FontSize="11" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Footer Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Style="{StaticResource SecondaryButton}" Content="Cancel" Width="85" Margin="0,0,10,0" IsCancel="True" />
            <Button Style="{StaticResource PrimaryButton}" Content="Create Project" Width="125" Click="CreateButton_Click" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
