<!-- [v0.2: NewRuleDialog] Modal dialog for quickly creating classification rules from the Daily Timeline -->
<Window x:Class="IdleWork.App.Views.NewRuleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create New Classification Rule"
        Height="540" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BgDarkBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="8" Padding="14" Margin="0,0,0,16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Create New Classification Rule" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                <TextBlock Text="Define pattern matchers to automatically tag matching window activities." Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,2,0,0" />
            </StackPanel>
        </Border>

        <!-- Form -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Rule Name *" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" />
                    <TextBox x:Name="RuleNameTextBox" Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Process / App Filter *" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" />
                            <TextBox x:Name="ProcessTextBox" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Window Title Pattern / Keyword" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,2" />
                            <TextBlock Text="Matches text in window title (e.g. 'Hospital'). Blank matches all." FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,4" />
                            <TextBox x:Name="TitlePatternTextBox" ToolTip="Case-insensitive title substring. E.g. 'Hospital' matches 'AutoCAD - Hospital Level 1.dwg'. Leave blank for all windows." />
                        </StackPanel>
                    </Grid>

                    <!-- Target Project with Quick-Create -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Target Project *" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Style="{StaticResource SecondaryButton}"
                                Content="➕ New Project"
                                FontSize="11"
                                Padding="8,2"
                                VerticalAlignment="Center"
                                Click="NewProject_Click"
                                ToolTip="Create a new project on the fly" />
                    </Grid>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="ProjectsComboBox"
                                  Grid.Column="0"
                                  Margin="0,0,8,0"
                                  SelectionChanged="ProjectsComboBox_SelectionChanged" />
                        <Button Grid.Column="1"
                                Style="{StaticResource SecondaryButton}"
                                Content="➕ New"
                                Padding="12,6"
                                VerticalAlignment="Stretch"
                                Click="NewProject_Click"
                                ToolTip="Create a new project on the fly" />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Target Category" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,2" />
                            <TextBlock Text="Select from list or type new" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <ComboBox x:Name="CategoryComboBox" IsEditable="True" ToolTip="Select a predefined category (e.g. BIM, Development) or type a custom one." />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Target Tags" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,2" />
                            <TextBlock Text="Select tag or enter tags" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <ComboBox x:Name="TagsComboBox" IsEditable="True" ToolTip="Select predefined tag or enter comma-separated tags (e.g. Revit, 3D)." />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Footer Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource SecondaryButton}" Content="Cancel" Width="85" Margin="0,0,10,0" IsCancel="True" />
            <Button Style="{StaticResource PrimaryButton}" Content="Create Rule" Width="125" Click="CreateButton_Click" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
