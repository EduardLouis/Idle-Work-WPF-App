<!-- [v0.1: MilestonesWindow] In-app Milestones modal window displaying version and history -->
<Window x:Class="IdleWork.App.Views.MilestonesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        mc:Ignorable="d"
        Title="Idle-Work Milestones &amp; Version History"
        Height="550" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgDarkBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="8" Padding="16" Margin="0,0,0,16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Idle-Work Activity &amp; Time Tracker" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="Version History &amp; Release Milestones" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,0" />
                </StackPanel>

                <!-- Version Badge -->
                <Border Grid.Column="1" Background="#0F172A" CornerRadius="6" Padding="10,6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Active: " Foreground="{StaticResource TextMutedBrush}" FontSize="12" />
                        <TextBlock Text="{Binding Version, StringFormat='v{0}'}" FontWeight="Bold" Foreground="{StaticResource ActiveBrush}" FontSize="12" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding BuildTimestamp, StringFormat='(Build {0})'}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Markdown / Text viewer for MILESTONES.md -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBox Text="{Binding MilestoneContent, Mode=OneWay}" 
                         IsReadOnly="True" 
                         Background="Transparent" 
                         BorderThickness="0" 
                         Foreground="{StaticResource TextPrimaryBrush}" 
                         FontFamily="Cascadia Code, Consolas, Segoe UI" 
                         FontSize="12" 
                         TextWrapping="Wrap" />
            </ScrollViewer>
        </Border>

        <!-- Footer -->
        <Button Grid.Row="2" Style="{StaticResource SecondaryButton}" Content="Close" HorizontalAlignment="Right" Width="90" Margin="0,16,0,0" Click="CloseButton_Click" />
    </Grid>
</Window>
